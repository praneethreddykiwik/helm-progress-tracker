# Copy to .env. No secrets are included. Restart after editing.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
APP_NAME=Helm Track
# Local SQLite is used when DATABASE_URL is empty. Production: Supabase Session pooler URI.
DATABASE_URL=
# Production CA certificate path; certificate verification always enabled.
DATABASE_CA_FILE=
DATA_DIR=.data
# Generate with: openssl rand -hex 32. Required in production.
SESSION_SECRET=
# Set in production to a non-public schema owned by the dedicated application DB role.
DATABASE_SCHEMA=helm
# S3-compatible private storage (Supabase Storage supports S3 credentials)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=helm-screenshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# n8n production webhook; worker runs separately, not in browser.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Separate scheduler Bearer credential, generate 32+ random characters.
N8N_SCHEDULER_SECRET=
# Integration base URL must be reachable from n8n, HTTPS in production.
INTEGRATION_BASE_URL=
# Set after verifying your sending domain with Resend; credential stays in n8n.
EMAIL_FROM=
EMAIL_SENDER_NAME=Helm Track
# Set for provider delivery/bounce webhook verification (Resend/Svix).
RESEND_WEBHOOK_SECRET=
# Set to 1 ONLY when behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
