  },
  "nodes": [
    {
      "id": "d09979f3-39fc-4344-8222-e56ae62e2209",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -280
      ],
      "parameters": {
        "width": 1060,
        "height": 220,
        "content": "## Helm Track · Reliable notification delivery\nHandles new submissions + acknowledgment (A), approved retests (B), retest results (C), and information requests/replies (D).\n\n**Before publishing:** set the HTTPS app origin in Validate envelope; select Header Auth on the webhook (`X-Helm-Webhook-Secret`); select Resend Header Auth (`Authorization: Bearer …`) on Send via Resend. Do not put credentials into node text. The app outbox retries safely and rechecks issue status. Execution payload saving is disabled because notifications contain private data.\n\n**Provider accepted ≠ delivered.** Signed delivery/bounce webhooks go directly to the app."
      }
    },
    {
      "id": "0f76806f-c006-4798-8f94-04ccf73ca461",
      "name": "Notification webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        80
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "helm-track-notifications",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "999cd790-2a2e-4b4d-a69f-1523ca35d95c"
    },
    {
      "id": "d7d903f8-1f12-4970-9cf1-5b17494faa67",
      "name": "Validate envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "jsCode": "function validateDispatch(payload, expectedOrigin, clock = Date.now()) {\n  if (!expectedOrigin || !/^https:\\/\\/[a-z0-9.-]+(?::[0-9]+)?$/i.test(expectedOrigin)) {\n    throw new Error('Configure the HTTPS app origin in this node before enabling delivery.');\n  }\n  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n  if (!payload || payload.schema_version !== 1 || !uuid.test(payload.delivery_id || '') || !uuid.test(payload.event_id || '')) {\n    throw new Error('Invalid notification envelope.');\n  }\n  if (typeof payload.capability !== 'string' || !/^[0-9a-f]{64}$/.test(payload.capability)) {\n    throw new Error('Invalid notification capability.');\n  }\n  if (!Number.isFinite(payload.timestamp) || Math.abs(clock - payload.timestamp) > 300000) {\n    throw new Error('Expired notification envelope.');\n  }\n  if (payload.base_url !== expectedOrigin) throw new Error('Application origin does not match the configured allowlist.');\n  return { delivery_id: payload.delivery_id, event_id: payload.event_id, capability: payload.capability, base_url: expectedOrigin };\n}\n\nconst APP_ORIGIN = ''; // REQUIRED: exact public HTTPS app origin, with no trailing slash.\nreturn [{json: validateDispatch($input.first().json.body, APP_ORIGIN)}];"
      }
    },
    {
      "id": "710e6304-8109-4061-89a4-1d0f7749f3a5",
      "name": "Claim current notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate envelope').first().json.base_url + '/api/integration/claim' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Validate envelope').first().json.capability }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "844dcf36-2158-426a-bde9-cb710a2eb0ca",
