          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f25b9666-fa1e-472f-802a-54a00ac42ecd",
              "leftValue": "={{ $json.send }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ab7f84d0-6a5c-4381-9861-08cf3a13e7cd",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.email }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "5fac7ba5-8a40-4dca-8428-7669c63b51f1",
      "name": "Classify provider outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "function classifyOutcome(response, executionId) {\n  const code = Number(response.statusCode || 0);\n  const body = response.body || {};\n  if (code >= 200 && code < 300 && typeof body.id === 'string' && body.id) {\n    return { state: 'provider-accepted', provider_id: body.id, execution_id: String(executionId) };\n  }\n  if (code === 429 || code >= 500 || !code || code >= 200 && code < 300) {\n    return { state: 'uncertain', error: 'unknown_outcome', execution_id: String(executionId) };\n  }\n  return { state: 'failed', error: 'provider_rejected', execution_id: String(executionId) };\n}\n\nreturn [{json:classifyOutcome($input.first().json, $execution.id)}];"
      }
    },
    {
      "id": "83e93987-9e64-415a-a4a5-a15d5e3216ae",
